<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/logo_circle"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="22dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/white" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/lock_view0_text"
        android:textColor="@color/text"
        android:textSize="@dimen/text_headline"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/lock_view1_text"
        android:textColor="@color/text2"
        android:textSize="@dimen/text_body_s" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/field_bg"
        android:gravity="center"
        android:hint="@string/lock_etpin_hint"
        android:inputType="textPassword"
        android:letterSpacing="0.4"
        android:maxLength="64"
        android:padding="14dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text2"
        android:textSize="@dimen/text_headline" />

    <TextView
        android:id="@+id/tvLockError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/danger"
        android:textSize="@dimen/text_body_s"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:backgroundTint="@color/brand_button"
        android:text="@string/lock_btnunlock_text"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnBiometric"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/lock_btnbiometric_text"
        android:textColor="@color/brand"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnForgotPin"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/lock_btnforgotpin_text"
        android:textColor="@color/danger" />
</LinearLayout>
