<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/logo_circle"
        android:gravity="center"
        android:text="🔒"
        android:textColor="@color/white"
        android:textSize="30sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="مموت قفل است"
        android:textColor="@color/text"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="رمز قفل برنامه را وارد کنید"
        android:textColor="@color/text2"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etPin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:background="@drawable/field_bg"
        android:gravity="center"
        android:hint="رمز قفل"
        android:inputType="textPassword"
        android:letterSpacing="0.4"
        android:maxLength="64"
        android:padding="14dp"
        android:textColor="@color/text"
        android:textColorHint="@color/text2"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvLockError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:textColor="@color/danger"
        android:textSize="14sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="@color/brand"
        android:text="باز کردن"
        android:textColor="@color/white" />

    <Button
        android:id="@+id/btnBiometric"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="ورود با اثر انگشت / چهره"
        android:textColor="@color/brand"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnForgotPin"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="رمز قفل را فراموش کرده‌ام"
        android:textColor="@color/danger" />
</LinearLayout>
