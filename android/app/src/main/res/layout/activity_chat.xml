<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/chat_wallpaper"
    android:orientation="vertical">

    <!--
      iMessage-style centered header (Figma reference): avatar + name pill
      + status stacked in the center, circular icon buttons on both sides.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="104dp"
        android:background="@color/surface"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvChatAvatar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/avatar_circle"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutChatHeader"
                android:contentDescription="اطلاعات گفتگو"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/name_pill_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="8dp"
                android:paddingBottom="4dp">

                <TextView
                    android:id="@+id/tvChatTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:textColor="@color/text"
                    android:textSize="14.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:importantForAccessibility="no"
                    android:text="‹"
                    android:textColor="@color/text2"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvChatStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:maxWidth="190dp"
                android:textColor="@color/text2"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="بازگشت"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_rtl"
            android:tint="@color/brand" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="12dp"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnChatSearch"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/icon_circle_bg"
                android:contentDescription="جستجو در گفتگو"
                android:padding="14dp"
                android:src="@drawable/ic_search"
                android:tint="@color/text2" />

            <ImageButton
                android:id="@+id/btnSecurity"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:layout_marginStart="8dp"
                android:background="@drawable/icon_circle_bg"
                android:contentDescription="امنیت گفتگو"
                android:padding="14dp"
                android:src="@drawable/ic_lock"
                android:tint="@color/text2" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_gravity="bottom"
            android:background="@color/separator" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnBannerAction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/brand_button"
            android:textColor="@color/white"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/chat_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="8dp"
        android:visibility="gone">

        <EditText
            android:id="@+id/etChatSearch"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/field_bg"
            android:hint="جستجو در این گفتگو…"
            android:inputType="text"
            android:padding="10dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text2" />

        <ImageButton
            android:id="@+id/btnSearchPrev"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="نتیجه‌ی قبلی"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_up"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnSearchNext"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="نتیجه‌ی بعدی"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_down"
            android:tint="@color/text" />

        <ImageButton
            android:id="@+id/btnSearchClose"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="بستن جستجو"
            android:padding="12dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text" />
    </LinearLayout>

    <Button
        android:id="@+id/btnLoadOlder"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:text="نمایش پیام‌های قدیمی‌تر ↑"
        android:textColor="@color/brand"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lvMessages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:paddingTop="6dp"
            android:paddingBottom="10dp"
            android:scrollbars="none" />

        <!-- Animated three-dot typing bubble (peer messages side). -->
        <LinearLayout
            android:id="@+id/layoutTyping"
            android:contentDescription="در حال نوشتن است"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bubble_theirs"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:visibility="gone">

            <TextView android:id="@+id/tvTypeDot1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="●" android:textColor="@color/text2" android:importantForAccessibility="no" android:textSize="8sp" />
            <TextView android:id="@+id/tvTypeDot2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="●" android:textColor="@color/text2" android:importantForAccessibility="no" android:textSize="8sp" />
            <TextView android:id="@+id/tvTypeDot3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="●" android:textColor="@color/text2" android:importantForAccessibility="no" android:textSize="8sp" />
        </LinearLayout>

        <!-- Telegram-style scroll-to-bottom with unread-below badge. -->
        <FrameLayout
            android:id="@+id/layoutScrollDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnScrollDown"
                android:layout_width="@dimen/touch_min"
                android:layout_height="@dimen/touch_min"
                android:background="@drawable/icon_circle_bg"
                android:contentDescription="رفتن به تازه‌ترین پیام"
                android:elevation="5dp"
                android:padding="13dp"
                android:src="@drawable/ic_chevron_down"
                android:tint="@color/text" />

            <TextView
                android:id="@+id/tvScrollBadge"
                android:layout_width="wrap_content"
                android:layout_height="19dp"
                android:layout_gravity="top|end"
                android:background="@drawable/badge_bg"
                android:gravity="center"
                android:minWidth="19dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="@color/white"
                android:textSize="@dimen/text_meta"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <LinearLayout
        android:id="@+id/layoutReply"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="7dp"
        android:paddingEnd="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvReplyQuote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text2"
            android:textSize="12.5sp" />

        <ImageButton
            android:id="@+id/btnCancelReply"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="لغو پاسخ"
            android:padding="14dp"
            android:src="@drawable/ic_close"
            android:tint="@color/text2" />
    </LinearLayout>

    <!-- Floating composer card: detached pill + circular blue send. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/composer_card_bg"
        android:elevation="7dp"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <EditText
            android:id="@+id/etMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@null"
            android:hint="پیام بنویسید…"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="4"
            android:minHeight="@dimen/touch_min"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="16dp"
            android:paddingBottom="9dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text2"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/btnTtl"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="حذف خودکار پیام"
            android:padding="14dp"
            android:src="@drawable/ic_timer"
            android:tint="@color/text2"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btnSend"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:background="@drawable/send_circle_bg"
            android:contentDescription="ارسال"
            android:padding="13dp"
            android:src="@drawable/ic_send_up"
            android:tint="@color/white" />
    </LinearLayout>
</LinearLayout>
