<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="1dp"
    android:paddingEnd="@dimen/space_l"
    android:paddingBottom="1dp">

    <!-- iOS-style day header: plain centered gray text, no pill. -->
    <TextView
        android:id="@+id/tvDay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/date_bg"
        android:textColor="@color/text2"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvQuote"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_xs"
        android:layout_marginEnd="@dimen/space_xs"
        android:layout_marginBottom="3dp"
        android:background="@drawable/quote_bg"
        android:maxLines="2"
        android:ellipsize="end"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text2"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBubble"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textDirection="firstStrong"
        android:lineSpacingMultiplier="1.18"
        android:paddingStart="14dp"
        android:paddingTop="9dp"
        android:paddingEnd="14dp"
        android:paddingBottom="9dp"
        android:textSize="@dimen/text_body" />

    <!-- Tapback-style reactions pill, pulled up to overlap the bubble. -->
    <TextView
        android:id="@+id/tvReactions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="-7dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/reactions_bg"
        android:elevation="2dp"
        android:paddingStart="@dimen/space_s"
        android:paddingTop="2dp"
        android:paddingEnd="@dimen/space_s"
        android:paddingBottom="2dp"
        android:textSize="@dimen/text_label"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvMeta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="3dp"
        android:layout_marginEnd="6dp"
        android:textColor="@color/text2"
        android:textSize="@dimen/text_meta" />
</LinearLayout>
