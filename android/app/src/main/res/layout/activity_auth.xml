<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="م"
            android:textColor="@color/white"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="مموت"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="چت متنی امن با رمزنگاری سرتاسری؛ فقط متن، بدون حاشیه."
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutMethodToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnMethodPhone"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📱 ورود با موبایل" />

            <Button
                android:id="@+id/btnMethodEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="✉️ ایمیل و رمز" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="کد تأیید ورود با پیامک ارسال می‌شود؛ نیازی به رمز عبور نیست."
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/field_bg"
                android:hint="شماره موبایل (مثل ۰۹۱۲۳۴۵۶۷۸۹)"
                android:inputType="phone"
                android:maxLength="20"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <Button
                android:id="@+id/btnSendCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/brand"
                android:text="دریافت کد تأیید"
                android:textColor="@color/white" />

            <LinearLayout
                android:id="@+id/layoutOtp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etOtpCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/field_bg"
                    android:gravity="center"
                    android:hint="کد ۶ رقمی پیامک‌شده"
                    android:inputType="number"
                    android:letterSpacing="0.35"
                    android:maxLength="6"
                    android:padding="13dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2"
                    android:textSize="20sp" />

                <Button
                    android:id="@+id/btnVerifyCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="@color/brand"
                    android:text="تأیید و ورود"
                    android:textColor="@color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnResend"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="ارسال دوباره کد"
                        android:textColor="@color/brand" />

                    <Button
                        android:id="@+id/btnChangeNumber"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="تغییر شماره"
                        android:textColor="@color/text2" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeLogin"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ورود" />

                <Button
                    android:id="@+id/btnModeSignup"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="ثبت‌نام" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/field_bg"
                android:hint="نام نمایشی"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="نام کاربری (انگلیسی، مثل mamoot_42)"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="ایمیل"
                android:inputType="textEmailAddress"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="رمز عبور (حداقل ۸ نویسه، حرف و عدد)"
                android:inputType="textPassword"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/brand"
                android:text="ورود"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnForgot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="رمز عبور را فراموش کرده‌ام"
                android:textColor="@color/brand" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تکمیل پروفایل"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/field_bg"
                android:hint="نام نمایشی"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <EditText
                android:id="@+id/etProfileUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="نام کاربری (انگلیسی)"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/tvProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfileSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/brand"
                android:text="شروع گفتگو"
                android:textColor="@color/white" />

            <Button
                android:id="@+id/btnProfileLogout"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="خروج از حساب"
                android:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="🔒 پیام‌های خصوصی روی همین گوشی رمزنگاری می‌شوند؛ سرور فقط متن رمز شده را می‌بیند."
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
