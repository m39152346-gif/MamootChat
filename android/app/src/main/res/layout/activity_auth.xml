<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="8dp"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_secure_hero" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="مموت"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="چت متنی امن با رمزنگاری سرتاسری؛ فقط متن، بدون حاشیه."
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/segmented_bg"
                android:orientation="horizontal"
                android:padding="4dp">

                <Button
                    android:id="@+id/btnModeLogin"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="ورود"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnModeSignup"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:text="ثبت‌نام"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etDisplayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/field_bg"
                android:hint="نام نمایشی"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="نام کاربری (انگلیسی، مثل mamoot_42)"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="ایمیل"
                android:inputType="textEmailAddress"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="رمز عبور (حداقل ۸ نویسه، حرف و عدد)"
                android:inputType="textPassword"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary_bg"
                android:text="ورود"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnForgot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="رمز عبور را فراموش کرده‌ام"
                android:textColor="@color/brand" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تکمیل پروفایل"
                android:textColor="@color/text"
                android:textSize="19sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileDisplay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/field_bg"
                android:hint="نام نمایشی"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <EditText
                android:id="@+id/etProfileUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/field_bg"
                android:hint="نام کاربری (انگلیسی)"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/tvProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="14sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfileSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_primary_bg"
                android:text="شروع گفتگو"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProfileLogout"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="خروج از حساب"
                android:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="🔒 پیام‌های خصوصی روی همین گوشی رمزنگاری می‌شوند؛ سرور فقط متن رمز شده را می‌بیند."
            android:textColor="@color/text2"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
