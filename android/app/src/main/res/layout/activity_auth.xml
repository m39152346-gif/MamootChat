<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="190dp"
            android:layout_marginTop="@dimen/space_s"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/img_secure_hero" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="14dp"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="@dimen/text_display"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/auth_view0_text"
            android:textColor="@color/text2"
            android:textSize="@dimen/text_body_s" />

        <LinearLayout
            android:id="@+id/layoutAuth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/segmented_bg"
                android:orientation="horizontal"
                android:padding="@dimen/space_xs">

                <Button
                    android:id="@+id/btnModeLogin"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:text="@string/auth_btnmodelogin_text"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnModeSignup"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_min"
                    android:layout_weight="1"
                    android:text="@string/auth_btnmodesignup_text"
                    android:textColor="@color/text"
                    android:textSize="@dimen/text_button"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/lblDisplayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/etDisplayName"
                android:text="@string/auth_lbldisplayname_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etDisplayName"
                android:autofillHints="name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_lbldisplayname_text"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:labelFor="@+id/etUsername"
                android:text="@string/auth_lblusername_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold"
                android:visibility="gone" />

            <EditText
                android:id="@+id/etUsername"
                android:autofillHints="username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_etusername_hint"
                android:textDirection="ltr"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:labelFor="@+id/etEmail"
                android:text="@string/auth_lblemail_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etEmail"
                android:autofillHints="emailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_lblemail_text"
                android:textDirection="ltr"
                android:inputType="textEmailAddress"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/lblPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:labelFor="@+id/etPassword"
                android:text="@string/auth_lblpassword_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPassword"
                android:autofillHints="password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_etpassword_hint"
                android:inputType="textPassword"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <CheckBox
                android:id="@+id/cbShowPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="@dimen/touch_min"
                android:text="@string/auth_cbshowpassword_text"
                android:textColor="@color/text2"
                android:textSize="@dimen/text_body_s" />

            <TextView
                android:id="@+id/tvAuthError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="@dimen/text_body_s"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnAuthSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/btn_primary_bg"
                android:text="@string/auth_btnmodelogin_text"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnForgot"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/auth_btnforgot_text"
                android:textColor="@color/brand" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_view1_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_headline"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblProfileDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:labelFor="@+id/etProfileDisplay"
                android:text="@string/auth_lbldisplayname_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileDisplay"
                android:autofillHints="name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_lbldisplayname_text"
                android:inputType="textPersonName"
                android:maxLength="50"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/lblProfileUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:labelFor="@+id/etProfileUsername"
                android:text="@string/auth_lblusername_text"
                android:textColor="@color/text"
                android:textSize="@dimen/text_label"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProfileUsername"
                android:autofillHints="username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/field_bg"
                android:hint="@string/auth_etprofileusername_hint"
                android:textDirection="ltr"
                android:inputType="text"
                android:maxLength="24"
                android:padding="13dp"
                android:textColor="@color/text"
                android:textColorHint="@color/text2" />

            <TextView
                android:id="@+id/tvProfileError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/danger"
                android:textSize="@dimen/text_body_s"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnProfileSubmit"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/btn_primary_bg"
                android:text="@string/auth_btnprofilesubmit_text"
                android:textColor="@color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnProfileLogout"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:minHeight="@dimen/touch_min"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_s"
                android:text="@string/auth_btnprofilelogout_text"
                android:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="@string/auth_view2_text"
            android:textColor="@color/text2"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</ScrollView>
