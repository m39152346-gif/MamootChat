<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chat_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/logo_circle"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="22dp"
            android:src="@drawable/ic_key"
            android:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="کلید رمزنگاری این گوشی خوانده نشد"
            android:textColor="@color/text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="کلید هویت چت‌های امن روی این دستگاه هست اما دیگر قابل خواندن نیست (مثلاً بعد از تغییر قفل صفحه یا خرابی حافظه امن). مموت کلید را خودکار عوض نمی‌کند؛ اول شما تصمیم بگیرید:\n\n• اگر فایل «پشتیبان رمزنگاری‌شده» دارید: با همان فایل بازیابی کنید تا همان کلید و تاریخچه برگردد.\n\n• اگر پشتیبان ندارید: می‌توانید کلید تازه بسازید. در این صورت چت‌های امن قبلی روی این گوشی دیگر باز نمی‌شوند و مخاطب‌ها باید کلید تازه شما را ببینند و بپذیرند."
            android:textColor="@color/text2"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnRecoverBackup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand_button"
            android:text="بازیابی از فایل پشتیبان"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnRecoverNewKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/danger_button"
            android:text="ساخت کلید تازه و ادامه"
            android:textColor="@color/white" />
    </LinearLayout>
</ScrollView>
