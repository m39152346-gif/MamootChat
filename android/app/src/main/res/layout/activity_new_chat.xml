<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_xs"
        android:paddingEnd="@dimen/space_m">

        <ImageButton
            android:id="@+id/btnBackNew"
            android:layout_width="@dimen/touch_min"
            android:layout_height="@dimen/touch_min"
            android:layout_marginStart="@dimen/space_s"
            android:background="@drawable/icon_circle_bg"
            android:contentDescription="@string/chat_btnback_desc"
            android:padding="14dp"
            android:src="@drawable/ic_chevron_rtl"
            android:tint="@color/brand" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_btnnewchat_desc"
            android:textColor="@color/text"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        android:background="@drawable/segmented_bg"
        android:orientation="horizontal"
        android:padding="@dimen/space_xs">

        <Button
            android:id="@+id/btnNewModeDm"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:text="@string/newchat_btnnewmodedm_text"
            android:textColor="@color/text"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNewModeGroup"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="@dimen/touch_min"
            android:layout_weight="1"
            android:text="@string/newchat_btnnewmodegroup_text"
            android:textColor="@color/text"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutGroupCreate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="13dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="13dp"
        android:orientation="vertical"
        android:visibility="gone">

        <EditText
            android:id="@+id/etGroupTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/field_bg"
            android:hint="@string/newchat_etgrouptitle_hint"
            android:inputType="text"
            android:maxLength="80"
            android:padding="13dp"
            android:textColor="@color/text"
            android:textColorHint="@color/text2" />

        <Button
            android:id="@+id/btnCreateGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/brand_button"
            android:enabled="false"
            android:text="@string/newchat_btncreategroup_text"
            android:textColor="@color/white" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="13dp"
        android:background="@drawable/field_bg"
        android:hint="@string/newchat_etsearch_hint"
        android:inputType="text"
        android:padding="13dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textColorHint="@color/text2" />

    <TextView
        android:id="@+id/tvSearchHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/space_l"
        android:text="@string/newchat_tvsearchhint_text"
        android:textColor="@color/text2"
        android:textSize="@dimen/text_body_s" />

    <ListView
        android:id="@+id/lvUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/surface"
        android:divider="@color/separator"
        android:dividerHeight="1dp" />
</LinearLayout>
