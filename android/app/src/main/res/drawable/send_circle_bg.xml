<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp touch box, 40dp visual gradient circle (4dp inset). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item android:id="@android:id/mask" android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval"><solid android:color="#FF000000" /></shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="270" android:startColor="@color/bubble_mine_start" android:endColor="@color/bubble_mine_end" />
        </shape>
    </item>
</ripple>
