<?xml version="1.0" encoding="utf-8"?>
<!-- RTL: my bubble sits on the left edge, so the tail corner is bottom-left. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:topLeftRadius="@dimen/radius_l" android:topRightRadius="@dimen/radius_l"
        android:bottomRightRadius="@dimen/radius_l" android:bottomLeftRadius="5dp" />
    <gradient android:type="linear" android:angle="270"
        android:startColor="@color/bubble_mine_start" android:endColor="@color/bubble_mine_end" />
</shape>
