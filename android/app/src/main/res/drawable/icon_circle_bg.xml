<?xml version="1.0" encoding="utf-8"?>
<!-- 48dp touch box, 38dp visual circle (5dp inset). Use on 48dp ImageButtons. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#26007AFF">
    <item android:id="@android:id/mask" android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval"><solid android:color="#FF000000" /></shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval"><solid android:color="@color/icon_circle" /></shape>
    </item>
</ripple>
